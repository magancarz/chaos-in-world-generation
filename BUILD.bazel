load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")

cc_library(
    name = "terrain-core",
    srcs = [
        "Source/WorldGeneration.cpp",
        "Source/WorldGeneration/NoiseMappingFunction.cpp",
    ],
    hdrs = [
        "Source/WorldGeneration.h",
        "Source/WorldGeneration/MappingInterval.h",
        "Source/WorldGeneration/NoiseMappingFunction.h",
    ],
    includes = ["Source"],
    deps = ["//ThirdParty:glm"],
)

cc_library(
    name = "chaos-in-world-generation-lib",
    srcs = glob(
        ["Source/**/*.cpp"],
        exclude = [
            "Source/WorldGeneration.cpp",
            "Source/WorldGeneration/NoiseMappingFunction.cpp",
        ],
    ),
    hdrs = glob(
        ["Source/**/*.h"],
        exclude = [
            "Source/WorldGeneration.h",
            "Source/WorldGeneration/MappingInterval.h",
            "Source/WorldGeneration/NoiseMappingFunction.h",
        ],
    ),
    includes = ["Source"],
    deps = [
        ":terrain-core",
        "//ThirdParty:glfw",
        "//ThirdParty:glm",
        "//ThirdParty:imgui",
        "//ThirdParty:opengl",
        "//ThirdParty:stb",
    ],
    linkopts = ["-ldl"],
)

cc_binary(
    name = "chaos-in-world-generation",
    srcs = ["Application/main.cpp"],
    data = glob(["Shaders/*"]) + [
        "//Managed:Terrain.Algorithm",
        "//Managed:Terrain.Bridge",
        "//Managed:managed_sources",
        "@rules_dotnet//dotnet:resolved_toolchain",
    ],
    deps = [
        ":chaos-in-world-generation-lib",
        "//ThirdParty:fast_noise_lite",
    ],
)

refresh_compile_commands(
    name = "refresh_compile_commands",
    exclude_external_sources = True,
    targets = {
        "//:chaos-in-world-generation": "-c opt",
    },
)
